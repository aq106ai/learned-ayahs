<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer on Android 12+ (android:dataExtractionRules). The cloud copy keeps only the
  user's own data (see backup_rules.xml for why the audio stays out). A device-to-device transfer
  has no such size limit, so it brings the saved recitations along too.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="audio/" />
    </device-transfer>
</data-extraction-rules>
