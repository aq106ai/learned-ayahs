# ===== Android / Gradle (learned-ayahs-quran-player) =====
.gradle/
**/app/build/
local.properties
*.apk
*.aab
*.keystore
captures/

# ===== Large media assets =====
*.mp3

# ===== Web player: generated output and personal data =====
# Everything below is produced by play_learned_ayahs.py from *your* library export, or is
# the export itself. It is personal (your learned ayahs, notes, local paths) and is
# regenerated on the next run, so it never belongs in the repository.
/web-app-quran-player/audio/
/web-app-quran-player/player.html
/web-app-quran-player/learned_ayahs_playlist.json
/web-app-quran-player/learned_ayahs.m3u
/web-app-quran-player/quran_text.json
/web-app-quran-player/word_timings.json
/web-app-quran-player/launcher.log
quran_library*.json

# ===== Web app: runtime data and tooling =====
# data/ holds the accounts database and the audio cache of a running server.py.
/web-app/data/
/web-app/node_modules/
/web-app/test-results/

