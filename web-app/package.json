{
  "name": "learned-ayahs-web",
  "private": true,
  "version": "1.0.0",
  "description": "Learned Ayahs web app: revise the ayahs you have memorised, in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "python3 server.py",
    "test": "node --test tests/unit/*.test.js",
    "test:server": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
